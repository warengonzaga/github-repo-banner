# Server Configuration
PORT=3000
NODE_ENV=development

# Official hosting: mandatory aggregate usage counts and optional public showcase
OFFICIAL_HOSTED_INSTANCE=false
# Required in official mode: choose saved-export retention (1–365 days).
# Public showcase copies remain until removed, independently of export retention.
EXPORT_RETENTION_DAYS=
# External origin for HTTPS reverse proxies/custom hosts (no path).
# Official mode defaults to https://ghrb.waren.build when empty.
PUBLIC_ORIGIN=

# Self-hosted stats tracking (disabled by default)
# Set to 'true' for daily aggregate origin request counts and estimated repository counts
# When disabled, no usage tracking occurs; Redis is still required for search caching and quotas
ENABLE_STATS=false

# Redis Configuration (required for every deployment)
# Example: redis://default:password@host:port or redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Pexels Integration (optional - enables Pexels search results in the UI)
# Get a free API key at https://www.pexels.com/api/
# The widget remains visible without a key; search requests return 503
PEXELS_API_KEY=
